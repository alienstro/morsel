{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-start-meeting",
    "allow-pause-meeting",
    "allow-resume-meeting",
    "allow-stop-meeting",
    "allow-save-user-notes",
    "allow-get-meeting",
    "allow-list-meetings",
    "allow-list-templates",
    "allow-get-settings",
    "allow-save-settings",
    "allow-set-api-key",
    "allow-has-api-key",
    "allow-test-notes-key",
    "allow-model-status",
    "allow-download-model",
    "allow-write-notes",
    "allow-cancel-notes",
    "allow-export-note",
    "dialog:allow-save",
    "allow-search-notes",
    "allow-list-people",
    "allow-delete-meeting",
    "allow-save-template",
    "allow-duplicate-template",
    "allow-delete-template",
    "allow-reset-template",
    "allow-ask",
    "allow-list-asks",
    "allow-get-ask",
    "allow-usage-summary",
    "allow-data-info",
    "allow-export-all",
    "allow-delete-all-data",
    "allow-microphone-access",
    "allow-request-microphone",
    "allow-open-privacy-settings",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir"
  ]
}

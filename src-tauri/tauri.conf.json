{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Morsel",
  "version": "0.1.0",
  "identifier": "app.morsel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Morsel",
        "width": 1280,
        "height": 820,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "morsel"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBOTVGRjNBQzkyNUZERUIKUldUci9TWEpPditWaW13aUV0UnpWZ2k5YlNEUE10SER5RmVHNzgwbkF6SlFSNHZwckp4QlZuNXkK",
      "endpoints": [
        "https://github.com/alienstro/morsel/releases/latest/download/latest.json"
      ]
    }
  }
}
